<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dopamine Simulator 9000</title>
    <style>
        body {
            background-color: #0f0f1a;
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
            user-select: none;
        }

        #score-container {
            text-align: center;
            margin-bottom: 20px;
        }

        #score {
            font-size: 4rem;
            font-weight: bold;
            color: #00ffcc;
            text-shadow: 0 0 20px #00ffcc;
            margin: 0;
            transition: transform 0.05s;
        }

        #pps {
            font-size: 1.2rem;
            color: #ff00ff;
            text-shadow: 0 0 10px #ff00ff;
            margin: 5px 0 0 0;
        }

        #main-button {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #ff00ff, #00ffff);
            box-shadow: 0 0 30px #ff00ff, inset 0 0 20px #ffffff;
            cursor: pointer;
            font-size: 1.5rem;
            font-weight: bold;
            color: white;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: transform 0.05s, box-shadow 0.1s;
            outline: none;
            margin-bottom: 40px;
        }

        #main-button:active {
            transform: scale(0.92);
            box-shadow: 0 0 50px #00ffff, inset 0 0 30px #ffffff;
        }

        #upgrades-container {
            display: flex;
            gap: 15px;
        }

        .upgrade-btn {
            background: #1f1f3a;
            border: 2px solid #3d3d75;
            color: white;
            padding: 12px 24px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
        }

        .upgrade-btn:hover:not(:disabled) {
            background: #2d2d5a;
            border-color: #00ffcc;
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.4);
            transform: translateY(-2px);
        }

        .upgrade-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .cost {
            font-size: 0.8rem;
            color: #ffcc00;
        }

        /* Efeito de textinho subindo (+1) */
        .floating-text {
            position: absolute;
            font-weight: bold;
            font-size: 1.5rem;
            pointer-events: none;
            animation: floatUp 0.6s ease-out forwards;
            text-shadow: 0 0 8px currentColor;
        }

        @keyframes floatUp {
            0% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            100% {
                opacity: 0;
                transform: translateY(-100px) scale(1.5);
            }
        }

        /* Pop-up de conquista */
        #achievement {
            position: fixed;
            top: -100px;
            background: linear-gradient(90deg, #ffe600, #ff0055);
            padding: 15px 30px;
            border-radius: 50px;
            box-shadow: 0 0 25px #ffe600;
            font-weight: bold;
            font-size: 1.2rem;
            transition: top 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 100;
        }

        #achievement.show {
            top: 20px;
        }
    </style>
</head>
<body>

    <div id="achievement">🏆 CONQUISTA DEBLOQUEADA! 🏆</div>

    <div id="score-container">
        <p id="score">0</p>
        <p id="pps">Pontos por segundo: 0</p>
    </div>

    <button id="main-button">CLIQUE!</button>

    <div id="upgrades-container">
        <button class="upgrade-btn" id="up-click">
            <span>🔥 Super Clique (+1/clique)</span>
            <span class="cost" id="cost-click">Custo: 15</span>
        </button>
        <button class="upgrade-btn" id="up-auto">
            <span>🤖 Auto-Clicador (+1 pps)</span>
            <span class="cost" id="cost-auto">Custo: 50</span>
        </button>
        <button class="upgrade-btn" id="up-hype">
            <span>⚡ Injetor de Hype (+10 pps)</span>
            <span class="cost" id="cost-hype">Custo: 500</span>
        </button>
    </div>

    <script>
        let score = 0;
        let pointsPerClick = 1;
        let pointsPerSecond = 0;

        // Custos iniciais
        let costClick = 15;
        let costAuto = 50;
        let costHype = 500;

        // Controle de conquistas para dar mais dopamina
        let achievementsUnlocked = { info50: false, info500: false, info5000: false };

        // Elementos do DOM
        const scoreEl = document.getElementById('score');
        const ppsEl = document.getElementById('pps');
        const mainBtn = document.getElementById('main-button');
        const upClickBtn = document.getElementById('up-click');
        const upAutoBtn = document.getElementById('up-auto');
        const upHypeBtn = document.getElementById('up-hype');
        const achEl = document.getElementById('achievement');

        // Sons visuais e lógicas de clique
        mainBtn.addEventListener('click', (e) => {
            score += pointsPerClick;
            createFloatingText(e.clientX, e.clientY, `+${pointsPerClick}`, '#00ffff');
            updateDisplay();
            triggerAnimate(scoreEl);
            checkAchievements();
        });

        // Compras de Upgrades
        upClickBtn.addEventListener('click', () => {
            if (score >= costClick) {
                score -= costClick;
                pointsPerClick += 1;
                costClick = Math.floor(costClick * 1.5);
                updateDisplay();
            }
        });

        upAutoBtn.addEventListener('click', () => {
            if (score >= costAuto) {
                score -= costAuto;
                pointsPerSecond += 1;
                costAuto = Math.floor(costAuto * 1.6);
                updateDisplay();
            }
        });

        upHypeBtn.addEventListener('click', () => {
            if (score >= costHype) {
                score -= costHype;
                pointsPerSecond += 10;
                costHype = Math.floor(costHype * 1.7);
                updateDisplay();
            }
        });

        // Loop do Auto-clique (Roda a cada 100ms para o número subir de forma fluida)
        setInterval(() => {
            if (pointsPerSecond > 0) {
                score += pointsPerSecond / 10;
                updateDisplay();
                checkAchievements();
            }
        }, 100);

        function updateDisplay() {
            scoreEl.innerText = Math.floor(score).toLocaleString();
            ppsEl.innerText = `Pontos por segundo: ${pointsPerSecond}`;
            
            // Atualiza textos dos custos
            document.getElementById('cost-click').innerText = `Custo: ${costClick}`;
            document.getElementById('cost-auto').innerText = `Custo: ${costAuto}`;
            document.getElementById('cost-hype').innerText = `Custo: ${costHype}`;

            // Habilita/Desabilita botões baseado no saldo
            upClickBtn.disabled = score < costClick;
            upAutoBtn.disabled = score < costAuto;
            upHypeBtn.disabled = score < costHype;
        }

        // Cria os numerozinhos voando na tela ao clicar
        function createFloatingText(x, y, text, color) {
            const el = document.createElement('div');
            el.className = 'floating-text';
            el.innerText = text;
            el.style.left = `${x - 20}px`;
            el.style.top = `${y - 20}px`;
            el.style.color = color;
            document.body.appendChild(el);

            setTimeout(() => {
                el.remove();
            }, 600);
        }

        // Animação rápida de "pulsar" no placar
        function triggerAnimate(element) {
            element.style.transform = 'scale(1.05)';
            setTimeout(() => {
                element.style.transform = 'scale(1)';
            }, 50);
        }

        // Sistema de recompensas psicológicas (Conquistas)
        function checkAchievements() {
            if (score >= 50 && !achievementsUnlocked.info50) {
                showAchievement("Início Humilde! (50 pontos)");
                achievementsUnlocked.info50 = true;
            }
            if (score >= 500 && !achievementsUnlocked.info500) {
                showAchievement("Mestre do Clique! (500 pontos)");
                achievementsUnlocked.info500 = true;
            }
            if (score >= 5000 && !achievementsUnlocked.info5000) {
                showAchievement("Capitalista da Dopamina! (5000 pontos)");
                achievementsUnlocked.info5000 = true;
            }
        }

        function showAchievement(text) {
            achEl.innerText = `🏆 ${text} 🏆`;
            achEl.classList.add('show');
            setTimeout(() => {
                achEl.classList.remove('show');
            }, 2500);
        }

        // Inicializa os botões como desabilitados se não houver pontos
        updateDisplay();
    </script>
</body>
</html>
